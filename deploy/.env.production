# Production Environment Configuration for Worker Connect
# IMPORTANT: Copy this to /var/www/worker-connect/.env and fill in real values
# NEVER commit real .env file to git!

# ===========================================
# REQUIRED SETTINGS
# ===========================================

# Django Secret Key (REQUIRED - Generate new one!)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-THIS-TO-RANDOM-SECRET-KEY-GENERATED-ABOVE

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Debug mode (MUST be False in production!)
DEBUG=False

# Allowed hosts (your domain names)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,72.62.51.225

# ===========================================
# DATABASE SETTINGS
# ===========================================

# PostgreSQL recommended for production
DATABASE_URL=postgresql://worker_connect_user:STRONG_PASSWORD_HERE@localhost:5432/worker_connect_db

# OR use SQLite for simple deployment (not recommended for production)
# DATABASE_URL=sqlite:///db.sqlite3

# ===========================================
# CORS SETTINGS
# ===========================================

# CORS allowed origins (web app URL only for web deployment)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# DO NOT allow all origins in production!
CORS_ALLOW_ALL_ORIGINS=False

# ===========================================
# SECURITY SETTINGS
# ===========================================

# Session cookie settings
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTPS redirect (set to True after SSL setup)
SECURE_SSL_REDIRECT=False
